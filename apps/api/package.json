{
  "name": "@workspace/api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:migrate": "bunx prisma migrate dev",
    "prisma:migrate:dev": "bunx prisma migrate dev",
    "prisma:migrate:deploy": "bunx prisma migrate deploy",
    "prisma:reset": "bunx prisma migrate reset --force",
    "prisma:generate": "bunx prisma generate",
    "dev": "../../node_modules/.bin/prisma generate && JWT_SECRET=$JWT_SECRET bun --watch src/server.ts",
    "build": "",
    "deploy": "bun run deploy",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "fix": "biome check --write ./src",
    "test": "vitest run --exclude **/*.e2e.spec.ts",
    "test:api": "vitest run --exclude **/*.e2e.spec.ts",
    "test:once": "vitest run",
    "migrate:legacy-posts": "bun run scripts/migrate-legacy-posts.ts"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "wrangler": "^4.45.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@xmldom/xmldom": "^0.9.7",
    "@hono/node-server": "^1.14.3",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.0",
    "@hono/zod-validator": "0.5.0",
    "@prisma/adapter-d1": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "hono": "4.7.9",
    "jose": "^5.5.0",
    "resend": "^6.0.2",
    "xss": "^1.0.15",
    "zod": "^4.0.0",
    "zod-prisma-types": "3.2.4"
  },
  "volta": {
    "node": "20.19.5"
  }
}
