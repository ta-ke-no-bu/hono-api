---
import Layout from '@layouts/Layout.astro'
import { type PublicCategory, type PublicPost, fetchPublicCategories, fetchPublicPosts } from '@lib/posts/api'
// import '@styles/page/news.scss'

export const prerender = false

const allPosts: PublicPost[] = (await fetchPublicPosts()).sort((a, b) => {
  const dateA = a.publishedAt ? new Date(a.publishedAt).getTime() : 0
  const dateB = b.publishedAt ? new Date(b.publishedAt).getTime() : 0
  return dateB - dateA
})

const allCategories: PublicCategory[] = await fetchPublicCategories()

const categoryNames = ['ALL', ...allCategories.map((c) => c.name)]

const formatDate = (dateString: string | null): string => {
  if (!dateString) return ''
  const date = new Date(dateString)
  const year = date.getFullYear()
  const month = (date.getMonth() + 1).toString().padStart(2, '0')
  const day = date.getDate().toString().padStart(2, '0')
  return `${year}${month}${day}`
}

type LinkInfo = {
  href: string
  external: boolean
}

const hasDetailPage = (post: PublicPost) => Boolean(post.detailEnabled && post.detailSlug)
const shouldShowInlineDetail = (post: PublicPost) => !hasDetailPage(post) && Boolean(post.detailBody)

const getLinkInfo = (post: PublicPost): LinkInfo | null => {
  if (hasDetailPage(post)) {
    return { href: `/posts/${encodeURIComponent(post.detailSlug)}`, external: false }
  }
  return null
}

const breadcrumbArray = [
  {
    href: Astro.url,
    label: 'NEWS',
  },
]
---

<Layout pageTitle='NEWS' pageTitleJa='お知らせ' breadcrumbArray={breadcrumbArray} mainClass='news'>
  <div class="news-tabs">
    <section role="tablist" aria-label="ニュースカテゴリ">
      {categoryNames.map((category, index) => (
        <button
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`panel-${category}`}
          id={`tab-${category}`}
          tabindex={index === 0 ? 0 : -1}
          data-category={category}
        >
          {category}
        </button>
      ))}
    </section>

    <div class="news-content">
      <ul class="news__list">
        {allPosts.map((post) => {
          const linkInfo = getLinkInfo(post)
          return (
            <li
              class:list={[
                'article-item',
                { accordion: shouldShowInlineDetail(post) },
              ]}
              data-category={post.categoryName}
              style="display: list-item;"
            >
              {shouldShowInlineDetail(post) ? (
                <details class="article-details">
                  <summary class="article-summary">
                    <div class="article-summary-content">
                      <div class="article-date">{formatDate(post.publishedAt)}</div>
                      <div class="article-category">{post.categoryName}</div>
                      <h2 class="article-title">{post.title}</h2>
                    </div>
                  </summary>
                  <div class="article-content" set:html={post.detailBody} />
                </details>
              ) : (
                <div class:list={['article-wrap', { 'no-icon': !linkInfo }]}>
                  <div class="article-date">{formatDate(post.publishedAt)}</div>
                  <div class="article-category">{post.categoryName}</div>
                  <h2 class="article-title">
                    {linkInfo ? (
                      <a
                        href={linkInfo.href}
                        target={linkInfo.external ? '_blank' : undefined}
                        rel={linkInfo.external ? 'noopener noreferrer' : undefined}
                      >
                        {post.title}
                      </a>
                    ) : (
                      post.title
                    )}
                  </h2>
                </div>
              )}
            </li>
          )
        })}
      </ul>
      <p class="no-articles-message" style="display: none;">このカテゴリには記事がありません。</p>
      <div class="pagination"></div>
    </div>
  </div>
</Layout>

<script src="./script.ts"></script>
