---
import '@styles/global.css'

const { pageTitleJa = 'ページ' } = Astro.props
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitleJa}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="border-b bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="text-lg font-semibold">サイト</a>
        <nav class="flex items-center gap-4 text-sm text-gray-600" aria-label="グローバルナビゲーション">
          <a href="/posts" class="hover:text-gray-900">投稿一覧</a>
          <a href="/contact" class="hover:text-gray-900">お問い合わせ</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
