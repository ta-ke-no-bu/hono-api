{
  "extends": ["../../packages/typescript-config/tsconfig.web.json", "astro/tsconfigs/base"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "@assets/*": ["./src/assets/*"],
      "@utils/*": ["src/utils/*"],
      "@lib/*": ["src/lib/*"],
      "@config/*": ["src/config/*"],
      "@stores/*": ["src/stores/*"],
      "@pages/*": ["src/pages/*"]
    }
  },
  "include": [
    "./src/**/*.d.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./src/**/*.js",
    "./src/**/*.astro",
    "./src/**/*.svelte",
    "env.d.ts"
  ]
}
