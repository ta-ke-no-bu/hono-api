{
  "name": "template-astro-bun",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bunx astro dev",
    "start": "bunx astro dev --host",
    "build": "bunx astro build",
    "delete": "rm -rf dist .astro",
    "preview": "bunx astro preview",
    "astro": "bunx astro",
    "lint": "bun run check:biome",
    "check:biome": "biome check src --config-path ../../biome.json",
    "format": "bun run fix:biome",
    "fix:biome": "biome check --write src --config-path ../../biome.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "0.9.3",
    "@astrojs/node": "8.3.4",
    "@astrojs/sitemap": "^3.5.1",
    "@astrojs/svelte": "^7.1.0",
    "@repo/ui": "workspace:*",
    "astro": "^5.13.5",
    "astro-compress": "^2.3.8",
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "lottie-web": "^5.13.0",
    "masonry-layout": "^4.2.2",
    "photoswipe": "^5.4.4",
    "rellax": "^1.12.1",
    "rollup": "4.20.0",
    "svelte": "^5.38.7",
    "swiper": "11.2.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "*",
    "@typescript-eslint/parser": "^6.21.0",
    "astro-relative-links": "^0.3.9",
    "playwright-config": "workspace:*",
    "postcss-html": "^1.8.0",
    "sass": "^1.90.0",
    "sharp": "^0.33.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.20.0"
  }
}
