{
  "name": "@workspace/admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file ./.env vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "bunx svelte-kit sync || echo ''",
    "check": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome lint ./src && eslint . --ext .svelte",
    "format": "biome format --write ./src && prettier --write .",
    "fix": "biome check --write ./src && prettier --write .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-cloudflare": "^7.2.3",
    "@sveltejs/kit": "^2.21.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "*",
    "@unocss/eslint-plugin": "^66.1.3",
    "eslint": "^9.28.0",
    "eslint-plugin-svelte": "^3.9.1",
    "playwright-config": "workspace:*",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.33.6",
    "svelte-check": "^4.2.1",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5",
    "autoprefixer": "^10.4.19"
  },
  "dependencies": {
    "@repo/tailwind-config": "*",
    "@repo/types": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tiptap/core": "^3.6.5",
    "@tiptap/extension-code-block-lowlight": "^3.6.5",
    "@tiptap/extension-highlight": "^3.6.5",
    "@tiptap/extension-image": "^3.6.5",
    "@tiptap/extension-link": "^3.6.5",
    "@tiptap/extension-placeholder": "^3.6.5",
    "@tiptap/extension-table": "^3.6.5",
    "@tiptap/extension-table-cell": "^3.6.5",
    "@tiptap/extension-table-header": "^3.6.5",
    "@tiptap/extension-table-row": "^3.6.5",
    "@tiptap/extension-task-item": "^3.6.5",
    "@tiptap/extension-task-list": "^3.6.5",
    "@tiptap/extension-text-align": "^3.6.5",
    "@tiptap/extension-underline": "^3.6.5",
    "@tiptap/pm": "^3.6.5",
    "@tiptap/starter-kit": "^3.6.5",
    "jose": "^5.5.0",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.0",
    "sortablejs": "^1.15.3",
    "svelte-french-toast": "^1.2.0",
    "update-browserslist-db": "^1.1.4",
    "uuid": "^13.0.0"
  }
}
